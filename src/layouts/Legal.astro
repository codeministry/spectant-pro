---
// Legal pages are German only (binding text); edited as whole documents, not as UI strings.
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

interface Props {
  path: string;
  title: string;
  description: string;
}

const { path, title, description } = Astro.props;
---

<Base locale="de" path={path} title={`${title} · spectant`} description={description}>
  <Nav locale="de" switchHref="/" />
  <main id="main" class="mx-auto max-w-3xl px-5 pb-24 pt-14 sm:px-8 sm:pt-20">
    <h1 class="text-3xl font-semibold tracking-tight [overflow-wrap:anywhere] sm:text-5xl">{title}</h1>
    <div
      class="legal mt-10 space-y-4 leading-relaxed text-muted [&_a]:link [&_a]:text-primary [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-base-content [&_h3]:mt-6 [&_h3]:font-semibold [&_h3]:text-base-content [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-base-content"
    >
      <slot />
    </div>
  </main>
  <Footer locale="de" cta={false} />
</Base>
