---
import GithubMark from './GithubMark.astro';
import Icon from './Icon.astro';
import SpecBoard from './SpecBoard';
import { GITHUB_URL, INSTALL_COMMAND } from '../site.config';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="mx-auto grid max-w-6xl items-center gap-14 px-5 pb-20 pt-14 sm:px-8 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-12 lg:pb-28 lg:pt-24">
  <div class="min-w-0">
    <p class="inline-flex items-center gap-2.5 rounded-full border border-line bg-base-100/70 px-3.5 py-1.5 text-sm font-medium">
      <span class="live-dot" aria-hidden="true"></span>
      {dict.hero.badge}
    </p>

    <h1 class="mt-7 text-[clamp(2.75rem,7vw,4.75rem)] font-semibold leading-[1.02] tracking-[-0.035em]">
      <span class="block">{dict.hero.titleA}</span>
      <span class="text-sweep block pb-1">{dict.hero.titleB}</span>
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{dict.hero.lead}</p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href={GITHUB_URL} class="btn btn-primary btn-lg rounded-field px-6" target="_blank" rel="noopener noreferrer">
        <GithubMark class="size-5" />
        {dict.hero.ctaPrimary}
      </a>
      <a href="#how" class="btn btn-ghost btn-lg rounded-field px-5">
        {dict.hero.ctaSecondary}
        <Icon name="ArrowDown" class="size-4" />
      </a>
    </div>

    <div class="mt-10 max-w-xl">
      <div
        class="flex items-center gap-3 rounded-field border border-dashed border-line bg-base-100/50 px-4 py-3 font-mono text-sm"
        aria-disabled="true"
      >
        <span class="select-none text-muted" aria-hidden="true">$</span>
        <code class="min-w-0 flex-1 truncate text-muted/80 select-none">{INSTALL_COMMAND}</code>
        <span class="badge badge-sm badge-soft badge-warning shrink-0 font-sans font-medium">
          {dict.hero.installSoon}
        </span>
      </div>
      <p class="mt-2.5 text-sm text-muted">{dict.hero.installNote}</p>
    </div>
  </div>

  <div class="min-w-0">
    <SpecBoard client:visible locale={locale} labels={dict.board} />
  </div>
</section>
