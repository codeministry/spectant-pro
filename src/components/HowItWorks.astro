---
import { INSTALL_COMMAND } from '../site.config';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section id="how" class="border-y border-line/60 bg-base-100/40">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:py-28">
    <div>
      <p class="eyebrow">{dict.how.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{dict.how.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{dict.how.lead}</p>
    </div>

    <div class="min-w-0">
      <div class="spec-card" data-accent="lime">
        <div class="flex items-center gap-1.5 border-b border-line px-4 py-3" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-line"></span>
          <span class="size-2.5 rounded-full bg-line"></span>
          <span class="size-2.5 rounded-full bg-line"></span>
        </div>
        <ol class="divide-y divide-line/70">
          {
            dict.how.steps.map((step, i) => (
              <li class="flex gap-4 px-5 py-5">
                <span class="mt-0.5 font-mono text-sm text-accent">0{i + 1}</span>
                <div class="min-w-0 flex-1">
                  <p class="flex items-center gap-2 font-mono text-sm">
                    <span class="select-none text-muted" aria-hidden="true">$</span>
                    <code class="min-w-0 truncate">{step.cmd ?? INSTALL_COMMAND}</code>
                  </p>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <p class="mt-3 text-sm text-muted">{dict.how.note}</p>
    </div>
  </div>
</section>
