---
// Chat + app: the Spec skill works from the AI chat, the app runs beside it as the overview. Both mocks carry demo data.
import Icon from './Icon.astro';
import { t } from '../i18n/utils';
import type { Dict, Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const { chat, app } = dict.duo;
const [command, ...output] = chat.lines;

// Marker per output line: progress, progress, done, what comes next.
const markers = [
  { icon: 'Dot', tone: 'text-muted' },
  { icon: 'Dot', tone: 'text-muted' },
  { icon: 'Check', tone: 'text-success' },
  { icon: 'CornerDownRight', tone: 'text-warning' },
] as const;

// Icon per planned item, in the order of dict.duo.planned.items.
const plannedIcons = ['MessageCircleReply', 'Plug', 'SquareArrowOutUpRight', 'Cpu', 'Radio', 'Blocks'] as const;

const stageBadge: Record<keyof Dict['board']['stages'], string> = {
  planned: 'badge-ghost',
  tasked: 'badge-soft badge-primary',
  implementing: 'badge-soft badge-warning',
  closed: 'badge-soft badge-success',
};
---

<section id="workflow" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-28">
  <div class="max-w-2xl">
    <p class="eyebrow">{dict.duo.eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{dict.duo.title}</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted">{dict.duo.lead}</p>
  </div>

  <div class="mt-12 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr]">
    <article class="spec-card flex flex-col p-6" data-accent="violet">
      <div class="flex items-center justify-between gap-3">
        <p class="flex items-center gap-2 text-sm font-medium text-muted">
          <Icon name="MessageSquare" class="size-4" />
          {chat.label}
        </p>
        <span class="flex shrink-0 gap-1.5">
          <span class="badge badge-sm badge-soft badge-secondary font-mono">{chat.badge}</span>
          <span class="badge badge-sm badge-ghost font-mono">{dict.features.stageLater}</span>
        </span>
      </div>

      <div class="mt-5 rounded-field border border-line bg-base-200 p-4 font-mono text-[13px] leading-relaxed">
        <p class="flex items-center gap-2">
          <span class="select-none text-secondary" aria-hidden="true">›</span>
          <span class="font-semibold">{command}</span>
        </p>
        <ul class="mt-2 space-y-1">
          {
            output.map((line, i) => (
              <li class="flex gap-2">
                <span class:list={['mt-[3px] shrink-0', markers[i]?.tone ?? 'text-muted']} aria-hidden="true">
                  <Icon name={markers[i]?.icon ?? 'Dot'} class="size-3.5" />
                </span>
                <span class="min-w-0 text-base-content/85">{line}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <h3 class="mt-6 text-lg font-semibold tracking-tight">{chat.title}</h3>
      <p class="mt-2 leading-relaxed text-muted">{chat.text}</p>
    </article>

    <div class="flex items-center justify-center" aria-hidden="true">
      <span class="inline-flex size-10 rotate-90 items-center justify-center rounded-full border border-line bg-base-100 text-muted lg:rotate-0">
        <Icon name="ArrowLeftRight" class="size-4" />
      </span>
    </div>

    <article class="spec-card flex flex-col p-6" data-accent="lime">
      <div class="flex items-center justify-between gap-3">
        <p class="flex items-center gap-2 text-sm font-medium text-muted">
          <Icon name="LayoutDashboard" class="size-4" />
          {app.label}
        </p>
        <span class="inline-flex items-center gap-2 text-xs text-muted">
          <span class="live-dot" aria-hidden="true"></span>
          {app.updated}
        </span>
      </div>

      <div class="mt-5 overflow-hidden rounded-field border border-line bg-base-200 text-sm">
        <ul class="divide-y divide-line/70">
          {
            app.rows.map((row) => (
              <li class="flex items-center gap-3 px-4 py-2.5">
                <span class="font-mono text-xs text-primary">{row.id}</span>
                <span class="min-w-0 flex-1 truncate">{row.name}</span>
                <span class:list={['badge badge-xs shrink-0 font-mono', stageBadge[row.stage]]}>
                  {dict.board.stages[row.stage]}
                </span>
                <span class="hidden w-11 shrink-0 text-right font-mono text-xs text-muted sm:inline">{row.progress}</span>
              </li>
            ))
          }
        </ul>
        <p class="flex items-start gap-2 border-t border-line/70 bg-warning/10 px-4 py-2.5 text-xs">
          <Icon name="Hand" class="mt-px size-3.5 shrink-0 text-warning" />
          <span class="min-w-0">{app.waiting}</span>
        </p>
      </div>

      <h3 class="mt-6 text-lg font-semibold tracking-tight">{app.title}</h3>
      <p class="mt-2 leading-relaxed text-muted">{app.text}</p>
    </article>
  </div>

  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <p class="inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-line bg-base-100/70 px-3.5 py-1.5 text-sm font-medium">
      <Icon name="FileText" class="size-4 text-accent" />
      {dict.duo.bridge}
    </p>
    <p class="max-w-xl text-sm leading-relaxed text-muted sm:text-right">{dict.duo.agents}</p>
  </div>

  <div class="mt-14">
    <h3 class="text-lg font-semibold tracking-tight">{dict.duo.planned.title}</h3>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        dict.duo.planned.items.map((item, i) => (
          <li class="rounded-box border border-dashed border-line bg-base-100/50 p-5">
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex size-8 items-center justify-center rounded-field border border-line bg-base-200 text-muted">
                <Icon name={plannedIcons[i] ?? 'Sparkles'} class="size-4" />
              </span>
              <span class="badge badge-sm badge-ghost font-mono">{dict.features.stageLater}</span>
            </div>
            <p class="mt-4 font-semibold tracking-tight">{item.title}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
