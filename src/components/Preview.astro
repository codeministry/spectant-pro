---
// Screens of the Spectant design prototype (spec 002), from the workspace overview down to a single spec.
// Thumbnail tabs switch the framed screen; clicking the screen opens a <dialog> with every screen full size in a
// scroll-snap track: swipe on touch, arrow buttons and keys elsewhere, the caption below, no counter.
// A screen with a light variant in ../assets/preview/light/ (same file name) shows it in the light theme.
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import allWorkspaces from '../assets/preview/all-workspaces.png';
import workspace from '../assets/preview/workspace-dashboard.png';
import library from '../assets/preview/spec-library-docs.png';
import dashboard from '../assets/preview/spec-dashboard.png';
import status from '../assets/preview/spec-status.png';
import liveBoard from '../assets/preview/live-board.png';
import tasks from '../assets/preview/tasks.png';
import notes from '../assets/preview/notes.png';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Same order as dict.preview.items.
const shots = [allWorkspaces, workspace, library, dashboard, status, liveBoard, tasks, notes];
const lightFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/preview/light/*.png', { eager: true });
const lightOf = (src: ImageMetadata) => {
  const name = src.src.split('/').pop()?.split('?')[0].replace(/\.[^.]+\.png$|\.png$/, '');
  return Object.entries(lightFiles).find(([path]) => path.endsWith(`/${name}.png`))?.[1].default;
};
const fullOf = async (src: ImageMetadata) => (await getImage({ src, width: 1440, format: 'webp' })).src;
const items = await Promise.all(
  dict.preview.items.map(async (item, i) => {
    const light = lightOf(shots[i]);
    return { ...item, src: shots[i], light, full: await fullOf(shots[i]), fullLight: light && (await fullOf(light)) };
  }),
);
---

<section id="preview" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-28" data-preview>
  <div class="max-w-2xl">
    <div class="flex flex-wrap items-center gap-3">
      <p class="eyebrow">{dict.preview.eyebrow}</p>
      <span class="badge badge-sm badge-soft badge-secondary font-mono">{dict.preview.badge}</span>
    </div>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{dict.preview.title}</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted">{dict.preview.lead}</p>
  </div>

  <div
    class="-mx-5 mt-10 flex snap-x scroll-px-5 gap-2 overflow-x-auto px-5 pb-2 sm:-mx-8 sm:scroll-px-8 sm:px-8 md:mx-0 md:grid md:grid-cols-4 md:overflow-visible md:px-0"
    role="tablist"
    aria-label={dict.preview.eyebrow}
  >
    {
      items.map((item, i) => (
        <button
          type="button"
          role="tab"
          id={`preview-tab-${i}`}
          aria-controls={`preview-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="preview-tab group w-36 shrink-0 snap-start rounded-field border border-line bg-base-100 p-1.5 text-left transition-colors hover:border-primary/50 aria-selected:border-primary aria-selected:bg-base-300/40 md:w-auto"
          data-tab={i}
        >
          {[item.src, item.light].filter(Boolean).map((src, v) => (
            <Image
              src={src!}
              alt=""
              width={320}
              class:list={[
                'aspect-[16/10] w-full rounded-[calc(var(--radius-field)-2px)] object-cover object-top opacity-70 transition-opacity group-hover:opacity-100 group-aria-selected:opacity-100',
                item.light && (v === 0 ? 'shot-dark' : 'shot-light'),
              ]}
            />
          ))}
          <span class="mt-1.5 block truncate px-1 pb-0.5 text-sm font-medium">{item.label}</span>
        </button>
      ))
    }
  </div>

  <div class="spec-card mt-4" data-accent="violet">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-line"></span>
        <span class="size-2.5 rounded-full bg-line"></span>
        <span class="size-2.5 rounded-full bg-line"></span>
      </span>
      <span class="flex-1 truncate text-center font-mono text-xs text-muted">127.0.0.1:7717</span>
      <span class="hidden items-center gap-1.5 text-xs text-muted sm:inline-flex">
        <Icon name="Maximize2" class="size-3.5" />
        {dict.preview.open}
      </span>
    </div>
    {
      items.map((item, i) => (
        <div role="tabpanel" id={`preview-panel-${i}`} aria-labelledby={`preview-tab-${i}`} hidden={i !== 0}>
          <button
            type="button"
            class="block w-full cursor-zoom-in"
            data-open={i}
            aria-label={`${dict.preview.open}: ${item.label}`}
          >
            {[item.src, item.light].filter(Boolean).map((src, v) => (
              <Image
                src={src!}
                alt={item.alt}
                widths={[640, 960, 1440]}
                sizes="(min-width: 1152px) 1088px, 100vw"
                class:list={['aspect-[16/10] w-full object-cover object-top', item.light && (v === 0 ? 'shot-dark' : 'shot-light')]}
              />
            ))}
          </button>
        </div>
      ))
    }
  </div>

  <dialog class="modal" data-preview-dialog aria-label={dict.preview.eyebrow}>
    <div class="modal-box flex h-[92dvh] w-[min(96vw,90rem)] max-w-none flex-col overflow-hidden bg-base-200 p-0">
      <form method="dialog" class="absolute right-2 top-2 z-10">
        <button class="btn btn-circle btn-sm border-line bg-base-100/90" aria-label={dict.preview.close}>
          <Icon name="X" class="size-4" />
        </button>
      </form>
      <div
        class="flex min-h-0 flex-1 snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-track
      >
        {
          items.map((item) => (
            <figure class="flex h-full w-full shrink-0 snap-center snap-always flex-col overflow-y-auto" data-slide>
              {[item.full, item.fullLight].filter(Boolean).map((src, v) => (
                <img
                  src={src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class:list={['my-auto w-full', item.fullLight && (v === 0 ? 'shot-dark' : 'shot-light')]}
                />
              ))}
            </figure>
          ))
        }
      </div>
      <div class="flex items-center gap-3 border-t border-line px-3 py-3 sm:px-4">
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-square hidden disabled:bg-transparent disabled:opacity-30 sm:inline-flex"
          aria-label={dict.preview.prev}
          data-prev
        >
          <Icon name="ChevronLeft" class="size-4" />
        </button>
        <p class="min-w-0 flex-1 text-center text-sm leading-snug text-muted" aria-live="polite" data-caption>
          {items[0].alt}
        </p>
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-square hidden disabled:bg-transparent disabled:opacity-30 sm:inline-flex"
          aria-label={dict.preview.next}
          data-next
        >
          <Icon name="ChevronRight" class="size-4" />
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button tabindex="-1">{dict.preview.close}</button>
    </form>
  </dialog>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-preview]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const dialog = root.querySelector<HTMLDialogElement>('[data-preview-dialog]');
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const caption = root.querySelector<HTMLElement>('[data-caption]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        select((i + step + tabs.length) % tabs.length, true);
      });
    });

    // The slide in view drives caption, buttons and which slide screen readers see.
    const show = (index: number) => {
      current = index;
      if (caption) caption.textContent = slides[index]?.querySelector('img')?.alt ?? '';
      // Both theme variants carry the same alt, so the first image is enough for the caption.
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== index)));
    };

    const go = (index: number) => {
      if (!track || index < 0 || index >= slides.length) return;
      track.scrollTo({ left: index * track.clientWidth, behavior: reduceMotion.matches ? 'instant' : 'smooth' });
    };

    let frame = 0;
    track?.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (index !== current) show(index);
      });
    });

    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));

    dialog?.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (step === 0) return;
      event.preventDefault();
      go(current + step);
    });

    // Closing leaves the tab of the last screen seen selected.
    dialog?.addEventListener('close', () => select(current));

    for (const opener of root.querySelectorAll<HTMLButtonElement>('[data-open]')) {
      opener.addEventListener('click', () => {
        if (!dialog || !track) return;
        const index = Number(opener.dataset.open);
        dialog.showModal();
        track.scrollLeft = index * track.clientWidth;
        show(index);
      });
    }
  }
</script>
