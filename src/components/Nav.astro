---
import GithubMark from './GithubMark.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { GITHUB_URL } from '../site.config';
import { homePath, otherLocale, t } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  /** Where the language switch points; defaults to the other locale's home page. */
  switchHref?: string;
}

const { locale } = Astro.props;
const dict = t(locale);
const home = homePath(locale);
const other = otherLocale(locale);
const switchHref = Astro.props.switchHref ?? homePath(other);
const anchor = (id: string) => (home === '/' ? `/#${id}` : `${home}#${id}`);
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-base-200/75 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={home} class="brand-rail focus-visible:outline-2 focus-visible:outline-primary" aria-label="spectant">
      <Logo />
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <a href={anchor('how')} class="btn btn-ghost btn-sm hidden font-medium md:inline-flex">{dict.nav.how}</a>
      <a href={anchor('roadmap')} class="btn btn-ghost btn-sm hidden font-medium md:inline-flex">{dict.nav.roadmap}</a>
      <ThemeToggle labels={dict.nav.theme} />
      <a href={switchHref} hreflang={other} lang={other} class="btn btn-ghost btn-sm font-mono text-xs uppercase">
        <span class="sr-only">{dict.nav.switchLabel}</span>
        <span aria-hidden="true">{other}</span>
      </a>
      <a href={GITHUB_URL} class="btn btn-sm border-line bg-base-100 font-medium" target="_blank" rel="noopener noreferrer">
        <GithubMark />
        <span class="hidden sm:inline">{dict.nav.github}</span>
        <span class="sm:hidden">GitHub</span>
      </a>
    </div>
  </nav>
</header>
