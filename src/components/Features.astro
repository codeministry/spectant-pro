---
import Icon from './Icon.astro';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Icon and accent per card, in the order of dict.features.items.
const decor = [
  { icon: 'LayoutGrid', accent: 'cyan' },
  { icon: 'Activity', accent: 'lime' },
  { icon: 'Laptop', accent: 'violet' },
  { icon: 'FileLock', accent: 'cyan' },
  { icon: 'Bot', accent: 'muted' },
  { icon: 'Puzzle', accent: 'muted' },
] as const;
---

<section id="features" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-28">
  <div class="max-w-2xl">
    <p class="eyebrow">{dict.features.eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{dict.features.title}</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted">{dict.features.lead}</p>
  </div>

  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      dict.features.items.map((item, i) => {
        const { icon, accent } = decor[i];
        const later = item.stage === 'later';
        return (
          <li class="spec-card p-6" data-accent={accent === 'cyan' ? undefined : accent}>
            <div class="flex items-start justify-between gap-3">
              <span
                class:list={[
                  'inline-flex size-10 items-center justify-center rounded-field border border-line bg-base-200',
                  later ? 'text-muted' : 'text-base-content',
                ]}
              >
                <Icon name={icon} class="size-5" />
              </span>
              <span class:list={['badge badge-sm font-mono', later ? 'badge-ghost' : 'badge-soft badge-primary']}>
                {later ? dict.features.stageLater : dict.features.stageFirst}
              </span>
            </div>
            <h3 class:list={['mt-5 text-lg font-semibold tracking-tight', later && 'text-base-content/80']}>
              {item.title}
            </h3>
            <p class="mt-2 leading-relaxed text-muted">{item.text}</p>
          </li>
        );
      })
    }
  </ul>
</section>
