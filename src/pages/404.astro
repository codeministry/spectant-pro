---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { t } from '../i18n/utils';

const en = t('en');
const de = t('de');
---

<Base locale="en" path="/404" title={`404 · ${en.notFound.title}`} noindex>
  <Nav locale="en" />
  <main id="main" class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-start justify-center px-5 py-24 sm:px-8">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
      <span class="text-sweep">{en.notFound.title}</span>
    </h1>
    <p class="mt-4 text-lg text-muted">{en.notFound.text}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary rounded-field">{en.notFound.back}</a>
      <a href="/de" hreflang="de" lang="de" class="btn btn-ghost rounded-field">{de.notFound.back}</a>
    </div>
  </main>
  <Footer locale="en" cta={false} />
</Base>
